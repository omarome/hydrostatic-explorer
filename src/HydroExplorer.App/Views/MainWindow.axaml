<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HydroExplorer.App.ViewModels"
        xmlns:views="using:HydroExplorer.App.Views"
        xmlns:models="using:HydroExplorer.Core.Models"
        x:Class="HydroExplorer.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1440" Height="900" MinWidth="960" MinHeight="600"
        Title="{Binding Title}">
    <!-- x:DataType tells the compiler which ViewModel this view binds to, so every {Binding}
         is checked at build time. WPF note: WPF has no compiled bindings (only d:DataContext
         as a designer hint); a typo in a WPF binding path only shows up as a runtime warning. -->

    <!-- DockPanel: children dock to an edge; the last child fills the remaining space. -->
    <DockPanel>

        <!-- Status bar: API connection state and last load time. Docked before the main area so it
             claims its strip at the bottom first. -->
        <Border DockPanel.Dock="Bottom" Padding="16,5" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                DataContext="{Binding Status}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding LastLoadText}" Classes="muted" FontSize="12" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Classes.connected="{Binding ...}" adds or removes the "connected" style class. -->
                    <Ellipse Classes="status-dot"
                             Classes.connected="{Binding IsConnected}"
                             Classes.disconnected="{Binding IsDisconnected}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ConnectionText}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Top bar: hull selector -->
        <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Hull" Classes="panel-title" />
                <!-- Bindings walk through properties: "Table.Hulls" = DataContext.Table.Hulls. -->
                <ComboBox ItemsSource="{Binding Table.Hulls}"
                          SelectedItem="{Binding Table.SelectedHull}"
                          MinWidth="320">
                    <ComboBox.ItemTemplate>
                        <!-- A DataTemplate says how to render one item (like the callback in items.map(...)).
                             It gets its own x:DataType because its DataContext is a Hull. -->
                        <DataTemplate x:DataType="models:Hull">
                            <TextBlock>
                                <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                <Run Text="{Binding Length, StringFormat='  L {0:0} m'}" />
                                <Run Text="{Binding Beam, StringFormat='× B {0:0} m'}" />
                                <Run Text="{Binding Depth, StringFormat='× D {0:0} m'}" />
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Main area: table on the left, chart and hull view stacked on the right.
             GridSplitters let the user drag the dividers. -->
        <Grid ColumnDefinitions="3*,Auto,2*" Margin="8">

            <!-- DataContext="{Binding Table}" hands the child view its own ViewModel (like passing props). -->
            <views:HydroTableView Grid.Column="0" DataContext="{Binding Table}" />

            <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns" />

            <Grid Grid.Column="2" RowDefinitions="*,Auto,*">
                <views:HydroChartView Grid.Row="0" DataContext="{Binding Chart}" />
                <GridSplitter Grid.Row="1" Height="6" Background="Transparent" ResizeDirection="Rows" />
                <views:HullView Grid.Row="2" DataContext="{Binding Hull}" />
            </Grid>
        </Grid>
    </DockPanel>

</Window>
