<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HydroExplorer.App.ViewModels"
             xmlns:controls="using:HydroExplorer.App.Controls"
             x:Class="HydroExplorer.App.Views.HullView"
             x:DataType="vm:HullViewModel">

    <Border Classes="panel">
        <Grid RowDefinitions="Auto,*">
            <DockPanel Grid.Row="0" Margin="4,0,4,4">
                <TextBlock DockPanel.Dock="Right" Text="{Binding HullName}" Opacity="0.8" VerticalAlignment="Center" />
                <TextBlock Text="Hull side view" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Our custom control. Its StyledProperties are bound like any built-in control's. -->
            <controls:HullProfileView Grid.Row="1"
                                      Length="{Binding Length}"
                                      Depth="{Binding Depth}"
                                      Draft="{Binding Draft}" />
        </Grid>
    </Border>
</UserControl>
