<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HydroExplorer.App.ViewModels"
             xmlns:controls="using:HydroExplorer.App.Controls"
             x:Class="HydroExplorer.App.Views.HullView"
             x:DataType="vm:HullViewModel">

    <Border Classes="panel">
        <Grid RowDefinitions="Auto,*,Auto">
            <DockPanel Grid.Row="0" Margin="4,0,4,4">
                <TextBlock DockPanel.Dock="Right" Text="{Binding HullName}" Classes="muted" VerticalAlignment="Center" />
                <TextBlock Text="Hull view" Classes="panel-title" />
            </DockPanel>

            <!-- Three drawings of the same hull, one per tab; 3D is first, so it's the default. All are our
                 custom controls; their StyledProperties are bound like any built-in control's. -->
            <TabControl Grid.Row="1" Padding="0">
                <TabItem Header="3D">
                    <controls:Ship3DView Length="{Binding Length}"
                                         Beam="{Binding Beam}"
                                         Depth="{Binding Depth}"
                                         Shape="{Binding Shape}"
                                         Draft="{Binding Draft}" />
                </TabItem>
                <TabItem Header="Side">
                    <controls:HullProfileView Length="{Binding Length}"
                                              Beam="{Binding Beam}"
                                              Depth="{Binding Depth}"
                                              Shape="{Binding Shape}"
                                              Draft="{Binding Draft}" />
                </TabItem>
                <TabItem Header="Body plan">
                    <controls:BodyPlanView Length="{Binding Length}"
                                           Beam="{Binding Beam}"
                                           Depth="{Binding Depth}"
                                           Shape="{Binding Shape}"
                                           Draft="{Binding Draft}" />
                </TabItem>
            </TabControl>

            <!-- Draft slider: another way to change the shared selection. Its range is 0.10 m to the
                 hull depth; moving it selects the nearest whole-centimetre draft. -->
            <DockPanel Grid.Row="2" Margin="4,4,4,0" IsVisible="{Binding HasHull}">
                <TextBlock DockPanel.Dock="Left" Text="Draft" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding DraftLabel}" VerticalAlignment="Center"
                           MinWidth="84" TextAlignment="Right" />
                <Slider Minimum="{Binding MinDraft}"
                        Maximum="{Binding Depth}"
                        Value="{Binding SliderDraft, Mode=TwoWay}"
                        SmallChange="0.01"
                        LargeChange="0.5" />
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
