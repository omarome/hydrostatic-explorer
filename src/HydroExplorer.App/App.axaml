<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HydroExplorer.App.App"
             RequestedThemeVariant="Default">
    <!-- RequestedThemeVariant="Default" follows the macOS light/dark setting. -->

    <Application.Styles>
        <FluentTheme />
        <!-- The DataGrid ships its own styles, which must be included explicitly. -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    </Application.Styles>
</Application>
