<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HydroExplorer.App.App"
             RequestedThemeVariant="Default">
    <!-- RequestedThemeVariant="Default" follows the macOS light/dark setting. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://HydroExplorer.App/Styles/Palette.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <!-- Same accent colour as AccentBrush in Palette.axaml (Navy in light, Teal in dark), so the
                 selected grid row, slider and chart read as one design.
                 These are StaticResource, not DynamicResource: FluentTheme.Palettes itself provides the
                 light/dark split, so each lookup only ever needs the one matching Color resource. -->
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="{StaticResource Navy}" />
                <ColorPaletteResources x:Key="Dark" Accent="{StaticResource Teal}" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <!-- The DataGrid ships its own styles, which must be included explicitly. -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <!-- App-wide styles (Border.panel, DataGrid, the status dot, ...), kept in their own file. -->
        <StyleInclude Source="avares://HydroExplorer.App/Styles/AppStyles.axaml" />
    </Application.Styles>
</Application>
